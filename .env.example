APP_NAME=Jarvis
DEBUG=false

# LLM
ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-4-6

# ChromaDB (embedded persistent client)
CHROMA_PATH=./chroma_data

# GitHub (Personal Access Token — scopes: repo, read:user)
GITHUB_TOKEN=github_pat_...

# Microsoft / OneNote (see scripts/get_microsoft_token.py for setup)
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_REFRESH_TOKEN=...
ONENOTE_NOTEBOOK=Personal
ONENOTE_SECTIONS=["Coding 2026"]

# API key — required on /chat and /ingest (leave empty to disable in dev)
API_KEY=your-secret-key-here

# LangSmith observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jarvis
