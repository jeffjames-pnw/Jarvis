APP_NAME=Jarvis
DEBUG=false

# LLM
ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-4-6

# ChromaDB (embedded persistent client)
CHROMA_PATH=./chroma_data

# GitHub (Personal Access Token — scopes: repo, read:user)
